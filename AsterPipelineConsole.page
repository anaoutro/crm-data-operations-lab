<apex:page controller="AsterPipelinePageController" showHeader="false" sidebar="false" standardStylesheets="false" docType="html-5.0">
<style>
:root{--ink:#17263e;--muted:#63718a;--line:#e6ebf3;--bg:#f4f7fb;--navy:#12223b;--blue:#385bdb;--coral:#e46854;--amber:#d7942c;--green:#24856b}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Arial,Helvetica,sans-serif}.shell{max-width:1320px;margin:auto;padding:44px 30px 64px}.brand{display:flex;align-items:center;gap:12px;font-size:13px;font-weight:800;letter-spacing:.16em;color:var(--navy);text-transform:uppercase}.mark{width:33px;height:33px;border-radius:10px;background:linear-gradient(135deg,#253862,#5a76eb);display:grid;place-items:center;color:white;font-size:18px}.hero{margin-top:36px;background:var(--navy);color:white;border-radius:22px;padding:40px 44px;box-shadow:0 18px 38px rgba(20,35,67,.12);position:relative;overflow:hidden}.hero:after{content:'';position:absolute;right:-90px;top:-100px;width:380px;height:380px;border:1px solid rgba(255,255,255,.18);border-radius:50%;box-shadow:0 0 0 60px rgba(255,255,255,.035),0 0 0 120px rgba(255,255,255,.025)}.eyebrow{font-size:11px;letter-spacing:.19em;text-transform:uppercase;font-weight:bold;color:#9eafff}.hero h1{font-size:38px;letter-spacing:-.04em;margin:13px 0 12px;position:relative;z-index:1}.hero p{max-width:660px;line-height:1.55;color:#c7d3e9;margin:0;position:relative;z-index:1}.notice{display:inline-block;margin-top:25px;border:1px solid rgba(255,255,255,.25);padding:9px 13px;border-radius:50px;font-size:12px;color:#dce4f6;position:relative;z-index:1}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:24px 0 30px}.metric{background:white;border:1px solid var(--line);border-radius:16px;padding:23px 21px;box-shadow:0 4px 16px rgba(26,48,89,.035)}.metric .label{font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}.metric .value{font-size:30px;letter-spacing:-.05em;font-weight:800;margin-top:12px}.metric .sub{font-size:12px;color:var(--muted);margin-top:6px}.critical .value{color:var(--coral)}.attention .value{color:var(--amber)}.healthy .value{color:var(--green)}.panel{background:white;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 8px 26px rgba(26,48,89,.04)}.panel-head{padding:25px 28px;display:flex;justify-content:space-between;align-items:center}.panel h2{margin:0;font-size:21px;letter-spacing:-.025em}.panel .caption{margin-top:5px;font-size:13px;color:var(--muted)}.pill{background:#edf1ff;color:#3754bb;border-radius:40px;padding:8px 12px;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.08em}table{width:100%;border-collapse:collapse;text-align:left}th{background:#f8faff;border-top:1px solid var(--line);border-bottom:1px solid var(--line);color:var(--muted);font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:15px 18px}td{border-bottom:1px solid var(--line);padding:18px;font-size:13px;vertical-align:top}tr:last-child td{border-bottom:0}.deal{font-weight:bold;color:var(--ink);display:block;margin-bottom:4px}.stage{color:var(--muted);font-size:12px}.badge{display:inline-block;border-radius:30px;padding:7px 10px;background:#eff2f8;color:#31435f;font-size:11px;font-weight:bold}.badge.Critical{background:#fff0ed;color:#bd4d3a}.badge.Attention{background:#fff5e5;color:#ab721f}.badge.Healthy{background:#e8f7f1;color:#177459}.reason{color:var(--muted);line-height:1.45;max-width:260px}.footer{margin-top:20px;color:var(--muted);font-size:12px;line-height:1.5}@media(max-width:1000px){.grid{grid-template-columns:repeat(3,1fr)}.panel{overflow-x:auto}table{min-width:850px}}@media(max-width:600px){.shell{padding:20px 14px}.hero{padding:28px 24px}.hero h1{font-size:29px}.grid{grid-template-columns:repeat(2,1fr)}.metric{padding:16px}.metric .value{font-size:24px}}
</style>
<main class="shell">
 <div class="brand"><span class="mark">A</span> Aster / Revenue Operations</div>
 <section class="hero"><div class="eyebrow">Salesforce · Opportunity Intelligence</div><h1>Opportunity Command Center</h1><p>A focused view of open pipeline quality. Each deal is checked for a missing next step, an overdue close date, and an invalid amount so sales teams can act on the right records first.</p><span class="notice">Live Developer Edition implementation · fictional portfolio data</span></section>
 <section class="grid">
  <div class="metric"><div class="label">Open deals</div><div class="value">{!summary.reviewed}</div><div class="sub">Records assessed</div></div>
  <div class="metric"><div class="label">Open value</div><div class="value"><apex:outputText value="{0,number,currency}"><apex:param value="{!summary.openAmount}"/></apex:outputText></div><div class="sub">Positive amounts only</div></div>
  <div class="metric critical"><div class="label">Critical</div><div class="value">{!summary.critical}</div><div class="sub">Two or more signals</div></div>
  <div class="metric attention"><div class="label">Attention</div><div class="value">{!summary.attention}</div><div class="sub">One signal</div></div>
  <div class="metric healthy"><div class="label">Healthy</div><div class="value">{!summary.healthy}</div><div class="sub">No signals</div></div>
 </section>
 <section class="panel"><div class="panel-head"><div><h2>Priority review</h2><div class="caption">Open opportunities, ordered by close date</div></div><span class="pill">Read-only · live CRM data</span></div><table><thead><tr><th>Opportunity</th><th>Health</th><th>Amount</th><th>Close date</th><th>Owner</th><th>Reason to act</th></tr></thead><tbody><apex:repeat value="{!summary.rows}" var="r"><tr><td><span class="deal"><apex:outputText value="{!r.name}"/></span><span class="stage"><apex:outputText value="{!r.stageName}"/></span></td><td><span class="badge {!r.severity}">{!r.severity}</span></td><td><apex:outputText value="{0,number,currency}"><apex:param value="{!r.amount}"/></apex:outputText></td><td><apex:outputText value="{0,date,MMM d, yyyy}"><apex:param value="{!r.closeDate}"/></apex:outputText></td><td><apex:outputText value="{!r.ownerName}"/></td><td class="reason"><apex:outputText value="{!r.reasons}"/></td></tr></apex:repeat></tbody></table></section>
 <div class="footer">Portfolio lab: all account and opportunity names are fictional. Risk signals are deterministic rules, not forecasts or outcomes. The controller reads up to 500 open opportunities with user-mode field and record access.</div>
</main>
</apex:page>
